    {
      "parameters": {
        "jsCode": "const raw = $input.item.json;\nconst body = raw.body || raw;\nconst venture = (body.venture || '').toLowerCase();\nconst topic = body.topic || '';\nif (!['trendai','happyhome','maxlearn'].includes(venture)) {\n  throw new Error(`Invalid venture: '${venture}' — must be one of trendai/happyhome/maxlearn`);\n}\nif (!topic) {\n  throw new Error('topic is required');\n}\nreturn { json: {\n  kind: 'content_idea_draft',\n  payload: {\n    venture,\n    topic,\n    enqueued_at: new Date().toISOString(),\n    source: 'webhook'\n  }\n}};"
      },
      "id": "55555555-aaaa-bbbb-cccc-000000000002",
      "name": "Validate + Build",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.task_queue (kind, payload) VALUES ($1, $2::jsonb) RETURNING id, kind, status, created_at;",
        "options": {
          "queryReplacement": "={{ $json.kind }},={{ JSON.stringify($json.payload) }}"
        }
      },
      "id": "55555555-aaaa-bbbb-cccc-000000000003",
      "name": "Insert Task Queue (tos_runtime)",
      "type": "n8n-nodes-base.postgres",
